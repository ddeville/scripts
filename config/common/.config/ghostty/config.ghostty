shell-integration = fish
shell-integration-features = no-cursor
clipboard-read = ask
clipboard-write = allow

font-family = AnonymicePro Nerd Font
font-family-bold = AnonymicePro Nerd Font
font-family-italic = AnonymicePro Nerd Font
font-family-bold-italic = AnonymicePro Nerd Font
font-style = Regular
font-style-bold = Regular
font-style-italic = Italic
font-style-bold-italic = Italic
bold-color = bright

cursor-style = block
cursor-style-blink = false
adjust-cursor-thickness = 2
bell-features = no-system,no-audio,no-attention,no-title,no-border

scrollback-limit = 100000000

title = "   ~(•_•)~   Ghostty"
window-inherit-working-directory = false
window-padding-balance = true
window-padding-y = 2

theme = light:Base16 Gruvbox Light Soft,dark:Base16 Gruvbox Dark Pale

# Generate background-relative shades for applications such as tmux.
palette-generate = true
palette-harmonious = true

# Stow installs the matching file from config/macos or config/linux.
config-file = ?platform.conf
