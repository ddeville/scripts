#!/bin/bash

# --local succeeds when the session is local and the desktop socket exists.
# --inherited tests whether SSH_AUTH_SOCK is the session's selected socket.
# --socket prints the selected socket path for Git.
# --link prepares the per-pane socket link used by OpenSSH.
set -eu

mode=$1
shift
socket=${SSH_AUTH_SOCK:-}
connection=${SSH_CONNECTION:-}

case "$mode" in
--local) [[ -S $1 ]] || exit 1 ;;
--socket | --inherited) ;;
--link) [[ -n ${TMUX:-} && ${TMUX_PANE:-} =~ ^%[0-9]+$ ]] || exit 1 ;;
*) exit 2 ;;
esac

if [[ -n ${TMUX:-} ]]; then
  session=$(tmux display-message -p -t "${TMUX_PANE:-}" '#{session_id}')
  [[ -n $session ]] || exit 1
  clients=$(tmux list-clients -t "$session" -F '#{?#{I/e:SSH_CONNECTION},ssh:#{I/e:SSH_AUTH_SOCK},#{?#{I/e:TERM},local:#{I/e:SSH_AUTH_SOCK},unknown}}')

  # Any SSH client in this session takes precedence over its desktop clients.
  connection=
  while IFS= read -r client; do
    case "$client" in
    ssh:*)
      socket=${client#ssh:}
      connection=ssh
      break
      ;;
    local:*) socket=${client#local:} ;;
    *) connection=unknown ;;
    esac
  done <<<"$clients"
  if [[ $connection == unknown ]]; then
    # Use the session environment when detached or when the client type is unknown.
    connection=$(tmux show-environment -t "$session" SSH_CONNECTION 2>/dev/null || :)
    socket=$(tmux show-environment -t "$session" SSH_AUTH_SOCK 2>/dev/null || :)
    [[ $connection == SSH_CONNECTION=?* ]] || connection=
    socket=${socket#SSH_AUTH_SOCK=}
  fi
fi

if [[ $mode == --local ]]; then
  [[ -z $connection ]]
  exit
fi

if [[ $mode == --inherited ]]; then
  [[ -S $socket && $socket != "$HOME/.ssh/ssh_auth_sock" && $socket -ef ${SSH_AUTH_SOCK:-} ]]
  exit
fi

if [[ -z $connection ]]; then
  for desktop_socket in "$@"; do
    if [[ -S $desktop_socket ]]; then
      # Desktop SSH matches already set IdentityAgent directly.
      [[ $mode != --link ]] || exit 1
      socket=$desktop_socket
      break
    fi
  done
fi

if [[ ! -S $socket || $socket == "$HOME/.ssh/ssh_auth_sock" ]]; then
  if [[ -n $connection ]]; then
    echo 'No forwarded SSH agent is available for this connection.' >&2
  elif [[ $mode == --socket ]]; then
    echo 'No local SSH agent is available.' >&2
  fi
  exit 1
fi

if [[ $mode == --socket ]]; then
  printf '%s\n' "$socket"
  exit
fi

link=$TMUX.$TMUX_PANE.agent
[[ ${TMUX_SSH_AUTH_SOCK:-} == "$link" && $TMUX == /*,*,* ]] || exit 1
[[ ! -e $link || -L $link ]] || exit 1
[[ -n $(find "${TMUX%/*}" -prune -user "$(id -un)" ! -perm -0020 ! -perm -0002 -print) ]] || exit 1
if [[ ! $link -ef $socket ]]; then
  ln -sfn "$socket" "$link"
fi
