#### Personal

Host *.home.kattungar.net *.lab.kattungar.net
    ForwardAgent yes
    Compression no

Host ddeville.me
    ForwardAgent yes

Match host "*.home.kattungar.net,*.lab.kattungar.net,ddeville.me,github.com,gitlab.com,bitbucket.com" exec "~/.ssh/ssh-session-agent --local ~/.1password/agent.sock"
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_personal.pub

#### OpenAI

Match all
    Include config_openai

#### Catch-all

Match host * exec "~/.ssh/ssh-session-agent --local ~/.1password/agent.sock"
    IdentityAgent ~/.1password/agent.sock

Match exec "~/.ssh/ssh-session-agent --link ~/.1password/agent.sock"
    IdentityAgent $TMUX_SSH_AUTH_SOCK

# If no rule above sets IdentityAgent, OpenSSH defaults to SSH_AUTH_SOCK.
# In tmux, allow that fallback only when the socket matches the current session.
Match exec "test -n \"$TMUX\" && ! ~/.ssh/ssh-session-agent --inherited"
    IdentityAgent none
