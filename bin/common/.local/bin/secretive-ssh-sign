#!/bin/bash

set -eu -o pipefail

# Verification uses public keys, so run ssh-keygen even when no agent is available.
SSH_AUTH_SOCK=$("$HOME/.ssh/ssh-session-agent" --socket "$HOME/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh" "$HOME/.1password/agent.sock" 2>/dev/null) || SSH_AUTH_SOCK=
export SSH_AUTH_SOCK

exec ssh-keygen "$@"
