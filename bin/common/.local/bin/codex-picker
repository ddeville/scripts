#!/bin/bash

set -eu -o pipefail

script_dir="$(cd -- "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")" && pwd)"

runtime_dir=$(mktemp -d "${TMPDIR:-/tmp}/codex-picker.XXXXXX")
snapshot_path="$runtime_dir/state.json"

collector_pid=''

# shellcheck disable=SC2329
cleanup() {
  if [[ -n $collector_pid ]]; then
    kill "$collector_pid" 2>/dev/null || true
    wait "$collector_pid" 2>/dev/null || true
  fi
  rm -f -- "$runtime_dir/state.json" "$runtime_dir/collector.log" "$runtime_dir"/.state.json.*
  rmdir -- "$runtime_dir"
}
trap 'cleanup' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# start the status collector in the background
"$script_dir/codex-status" --watch --output "$snapshot_path" >"$runtime_dir/collector.log" 2>&1 &
collector_pid=$!

printf -v render 'uv run --quiet --script %q --snapshot %q' "$script_dir/../lib/codex-picker.py" "$snapshot_path"
printf -v status '%q' "$script_dir/codex-status"
preview_command="if [[ {1} == - ]]; then $render message; else $status --detail {1} 2>/dev/null | $render detail; fi"
toggle_command="if [[ \$FZF_PROMPT == 'All agents › ' ]]; then
  echo 'change-prompt(Attention › )'
else
  echo 'change-prompt(All agents › )'
fi"
preview_layout='right,44%,wrap,border-left,<42(down,55%,border-top)'

result=0
FZF_DEFAULT_OPTS='' FZF_DEFAULT_OPTS_FILE='' fzf </dev/null \
  --ansi --delimiter=$'\t' --with-nth=2.. --track --id-nth=1 \
  --no-sort --layout=reverse --no-multi --no-hscroll \
  --border=rounded --border-label=' CODEX AGENTS ' \
  --padding=1 --info=inline-right --highlight-line --no-bold \
  --color='base16,fg:-1,bg:-1,hl:3,fg+:-1,bg+:237,hl+:3,query:-1,info:8,prompt:3,pointer:3,marker:3,spinner:3,border:8,header:8,footer:8,label:3,gutter:-1,preview-fg:-1,preview-bg:-1' \
  --prompt='All agents › ' --pointer='▌' \
  --header=$'Connecting to Codex…\nRefreshing every 2 seconds\n ' \
  --footer=$'Enter expand · Ctrl-f attention · Ctrl-/ details\n↑↓ move · Alt-j/k scroll details · Esc close' \
  --preview="$preview_command" --preview-window="$preview_layout" \
  --with-shell='bash -c' \
  --bind="start:reload-sync($render rows --wait)" \
  --bind="every(2):reload-sync($render rows)" \
  --bind="load:transform-header($render header)+refresh-preview" \
  --bind="ctrl-f:transform($toggle_command)+reload-sync($render rows)" \
  --bind="enter:change-preview-window(down,99%,wrap,border-none|$preview_layout)" \
  --bind='ctrl-/:toggle-preview,alt-j:preview-down,alt-k:preview-up' || result=$?

case $result in
0 | 1 | 130) exit 0 ;;
*) exit "$result" ;;
esac
