#!/bin/bash

set -eu -o pipefail

# Prefer a forwarded agent with keys; otherwise use the 1Password agent.
if [[ -z ${SSH_AUTH_SOCK:-} || ! -S ${SSH_AUTH_SOCK:-} || ${SSH_AUTH_SOCK:-} == /private/tmp/com.apple.launchd.* ]] || ! ssh-add -l >/dev/null 2>&1; then
  export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
fi

exec ssh-keygen "$@"
